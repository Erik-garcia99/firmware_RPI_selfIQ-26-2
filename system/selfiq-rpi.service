[Unit]
Description=SelfIQ Raspberry Pi provisioning gateway
Wants=selfiq-ap-network.service hostapd.service dnsmasq.service
After=selfiq-ap-network.service hostapd.service dnsmasq.service network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/selfiq-rpi
Environment=SELFIQ_STATE_FILE=/var/lib/selfiq/credentials.json
Environment=PYTHONPATH=/opt/selfiq-rpi/src
ExecStart=/usr/bin/python3 -m selfiq_rpi.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
