#!/usr/bin/env bash
# SelfIQ: reversible test of first-boot Wi-Fi provisioning over AP HTTP + TCP.
set -Eeuo pipefail
[[ ${EUID} -eq 0 ]] || { echo 'Ejecute con sudo.' >&2; exit 1; }

BACKUP_DIR=/var/lib/selfiq/wifi-test-backup
STATE=/var/lib/selfiq/credentials.json
STA=wlan0
BACKUP_TIME=8min
SELF=$(readlink -f "$0")

lookup_profile_file() {
  local uuid=$1 file
  for dir in /etc/NetworkManager/system-connections /run/NetworkManager/system-connections; do
    [[ -d $dir ]] || continue
    while IFS= read -r -d '' file; do
      if grep -qFx -- "uuid=$uuid" "$file"; then
        printf '%s\n' "$file"
        return 0
      fi
    done < <(find "$dir" -maxdepth 1 -type f -print0)
  done
  return 1
}

active_uuid() {
  nmcli -t -f UUID,DEVICE connection show --active | awk -F: -v iface="$STA" '$2==iface {print $1; exit}'
}

backup_profile() {
  local uuid=$1 file
  file=$(lookup_profile_file "$uuid") || {
    echo "ERROR: el perfil $uuid no está almacenado como keyfile de NetworkManager. Se detuvo sin cambiar nada." >&2
    exit 1
  }
  install -m 600 "$file" "$BACKUP_DIR/profiles/$uuid.nmconnection"
}

case "${1:-}" in
  start)
    if [[ -e $BACKUP_DIR/armed ]]; then
      echo "Prueba anterior pendiente. Compruebe: sudo $SELF status" >&2
      exit 1
    fi
    [[ -f /etc/selfiq/config.json ]] || { echo 'SelfIQ no está configurado.' >&2; exit 1; }
    systemctl is-active --quiet selfiq.service || { echo 'Primero inicie selfiq.service.' >&2; exit 1; }
    [[ $(nmcli -g GENERAL.TYPE device show "$STA") == wifi ]] || { echo 'wlan0 no es Wi-Fi.' >&2; exit 1; }
    ACTIVE=$(active_uuid)
    [[ -n $ACTIVE ]] || { echo 'No existe una conexión activa en wlan0.' >&2; exit 1; }
    install -d -m 700 "$BACKUP_DIR/profiles"
    echo "$ACTIVE" > "$BACKUP_DIR/active_uuid"
    chmod 600 "$BACKUP_DIR/active_uuid"
    backup_profile "$ACTIVE"
    # Guardar también perfiles SelfIQ previos, para que no conecten sin pasar por HTTP.
    for name in selfiq-sta-a selfiq-sta-b; do
      uuid=$(nmcli -g connection.uuid connection show "$name" 2>/dev/null || true)
      if [[ -n $uuid && $uuid != "$ACTIVE" ]]; then
        backup_profile "$uuid"
      fi
    done
    if [[ -f $STATE ]]; then
      install -m 600 "$STATE" "$BACKUP_DIR/credentials.json.old"
    fi
    printf '1\n' > "$BACKUP_DIR/armed"
    chmod 600 "$BACKUP_DIR/armed"
    # Si no es posible volver por el AP, se restaurará la conexión antigua.
    if ! systemd-run --quiet --unit=selfiq-wifi-rollback --on-active="$BACKUP_TIME" "$SELF" rollback; then
      rm -f "$BACKUP_DIR/armed"
      echo 'ERROR: no se pudo programar recuperación. No se modificó Wi-Fi.' >&2
      exit 1
    fi
    if ! systemd-run --quiet --unit=selfiq-wifi-cutover --on-active=20s "$SELF" cutover; then
      systemctl stop selfiq-wifi-rollback.timer || true
      rm -f "$BACKUP_DIR/armed"
      echo 'ERROR: no se pudo programar el cambio. No se modificó Wi-Fi.' >&2
      exit 1
    fi
    echo 'Prueba programada: en 20 segundos se eliminarán las credenciales de NetworkManager y SelfIQ.'
    echo "SSH por $STA se perderá. Conéctese al AP SelfIQ-Admi y abra http://192.168.50.1"
    echo 'Respaldo y recuperación automática programados a los 8 minutos.'
    echo 'Si completa la prueba, cancele la recuperación desde la Raspberry antes de que venza el plazo.'
    ;;
  cutover)
    [[ -e $BACKUP_DIR/armed ]] || exit 0
    # No tocar ni la URL del backend, ni el registro gateway.json ni las claves del gateway.
    rm -f "$STATE"
    for file in "$BACKUP_DIR"/profiles/*.nmconnection; do
      [[ -e $file ]] || continue
      uuid=$(basename "$file" .nmconnection)
      nmcli connection delete uuid "$uuid" || true
    done
    # Se ejecuta como tarea systemd local: no depende de una sesión SSH viva.
    systemctl restart selfiq.service
    echo 'Se borraron perfiles Wi-Fi para la prueba y se reinició SelfIQ; verificar AP HTTP.'
    ;;
  rollback)
    [[ -e $BACKUP_DIR/armed ]] || exit 0
    # Cuando HTTP ya configuró con éxito una red y wlan0 está conectada,
    # conservar el nuevo perfil y la identidad sin recuperar el anterior.
    if [[ -s $STATE && -n $(active_uuid) ]]; then
      echo 'Nueva conexión SelfIQ activa: no se restaura el perfil antiguo.'
      rm -f "$BACKUP_DIR/armed"
      exit 0
    fi
    install -d -m 700 /etc/NetworkManager/system-connections
    for file in "$BACKUP_DIR"/profiles/*.nmconnection; do
      [[ -e $file ]] || continue
      uuid=$(basename "$file" .nmconnection)
      if ! nmcli -g connection.uuid connection show "$uuid" &>/dev/null; then
        install -m 600 "$file" "/etc/NetworkManager/system-connections/selfiq-recovery-$uuid.nmconnection"
      fi
    done
    nmcli connection reload
    [[ -s $STATE ]] || {
      if [[ -f $BACKUP_DIR/credentials.json.old ]]; then
        install -m 600 "$BACKUP_DIR/credentials.json.old" "$STATE"
      fi
    }
    OLD_UUID=$(cat "$BACKUP_DIR/active_uuid")
    nmcli --wait 45 connection up uuid "$OLD_UUID" ifname "$STA" || true
    systemctl restart selfiq.service || true
    rm -f "$BACKUP_DIR/armed"
    echo 'Recuperación ejecutada. Revisar conexión wlan0 y estado selfiq.service.'
    ;;
  cancel)
    systemctl stop selfiq-wifi-rollback.timer || true
    rm -f "$BACKUP_DIR/armed"
    echo 'Recuperación automática cancelada. Conserve el respaldo hasta verificar todo.'
    ;;
  status)
    echo 'Estado programado:'
    systemctl list-timers --all --no-pager | grep -E 'selfiq-wifi-(cutover|rollback)' || true
    echo 'Estado Wi-Fi:'
    nmcli -f GENERAL.STATE,GENERAL.CONNECTION device show "$STA"
    echo 'Estado SelfIQ:'
    systemctl is-active selfiq.service || true
    echo 'Registros de prueba:'
    journalctl -u selfiq-wifi-cutover.service -u selfiq-wifi-rollback.service -n 15 --no-pager
    ;;
  *)
    echo "Uso: sudo $SELF {start|status|cancel|rollback}" >&2
    exit 2
    ;;
esac
